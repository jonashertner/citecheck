[Unit]
Description=citecheck: daily cite list, after the nightly pipeline

[Timer]
# The pipeline starts 03:30 UTC and ends between about 17:00 and 01:00 UTC; the
# service waits (up to 9 h, so until 02:30 UTC) if it is still running. The
# build takes minutes, well clear of the next pipeline start.
OnCalendar=*-*-* 17:30:00 UTC
Persistent=false

[Install]
WantedBy=timers.target
